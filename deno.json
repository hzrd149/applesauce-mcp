{
  "name": "@applesauce/mcp",
  "version": "0.5.4",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "dev": "npx -y @modelcontextprotocol/inspector@0.20 deno task cli",
    "dev-http": "deno run --env-file -P --watch src/cli.ts --mode http",
    "cli": "deno run --env-file -P src/cli.ts",
    "start": "deno run -P src/cli.ts --mode http",
    "check": "deno check src/cli.ts"
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.3.1",
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@cliffy/flags": "jsr:@cliffy/flags@^1.3.1",
    "@huggingface/transformers": "npm:@huggingface/transformers@^4.3.1",
    "@lancedb/lancedb": "npm:@lancedb/lancedb@^0.40.0",
    "@langchain/classic": "npm:@langchain/classic@^1.0.53",
    "@langchain/community": "npm:@langchain/community@^1.1.29",
    "@langchain/core": "npm:@langchain/core@^1.1.36",
    "@langchain/ollama": "npm:@langchain/ollama@^1.3.0",
    "@langchain/openai": "npm:@langchain/openai@^1.6.2",
    "@langchain/textsplitters": "npm:@langchain/textsplitters@^1.0.2",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.32.1",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "apache-arrow": "npm:apache-arrow@^18.1.0",
    "hono": "npm:hono@^4.13.13",
    "langchain": "npm:langchain@^1.5.18",
    "ollama": "npm:ollama@^0.6.4",
    "typescript": "npm:typescript@^6.0.3",
    "zod": "npm:zod@^4.6.7"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom"],
    "strict": true
  },
  "exclude": [
    "data",
    ".vscode",
    ".github"
  ],
  "permissions": {
    "default": {
      "sys": true,
      "env": true,
      "read": true,
      "ffi": true,
      "net": true,
      "run": true
    }
  }
}
